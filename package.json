{
  "name": "@cocreate/print",
  "version": "2.0.1",
  "description": "A simple print component in vanilla javascript. Easily configured using HTML5 data-attributes and/or JavaScript API.",
  "keywords": [
    "print",
    "low-code",
    "realtime",
    "realtime-framework",
    "collaboration",
    "shared-editing",
    "html5-framework",
    "javascript-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/print.git"
  },
  "author": "CoCreate LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CoCreateJS/print/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/print",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreateJS"
  },
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/actions": "^2.0.1",
    "@cocreate/element-prototype": "^2.0.1",
    "@cocreate/observer": "^2.0.1",
    "@cocreate/utils": "^2.0.2"
  },
  "devDependencies": {
    "@cocreate/webpack": "^2.0.1"
  },
  "allowScripts": {
    "@cocreate/actions@1.21.4": true,
    "@cocreate/element-prototype@1.31.4": true,
    "@cocreate/observer@1.19.0": true,
    "@cocreate/utils@1.42.2": true,
    "@cocreate/webpack@1.4.3": true
  }
}