{
  "name": "@cocreate/print",
  "version": "1.6.0",
  "description": "A simple print component in vanilla javascript. Easily configured using HTML5 data-attributes and/or JavaScript API.",
  "keywords": [
    "print",
    "low-code",
    "realtime",
    "realtime-framework",
    "collaboration",
    "shared-editing",
    "html5-framework",
    "javascript-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "client"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "A simple print component in vanilla javascript. Easily configured using HTML5 data-attributes and/or JavaScript API.",
      "source": "src/index.js",
      "declarative": {
        "selectors": [
          "[print-query]"
        ],
        "attributes": [
          {
            "name": "actions"
          },
          {
            "name": "aria-hidden"
          },
          {
            "name": "print-query"
          },
          {
            "name": "value"
          }
        ],
        "actions": [
          {
            "name": "print"
          }
        ]
      },
      "api": {
        "exports": [
          "init",
          "print"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocreatejs/CoCreate-print.git"
  },
  "author": "CoCreate LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CoCreateJS/CoCreate-print/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/print",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/actions": "^1.24.0",
    "@cocreate/element-prototype": "^1.35.0",
    "@cocreate/observer": "^1.23.0",
    "@cocreate/utils": "^1.54.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0"
  },
  "allowScripts": {
    "@cocreate/actions@1.21.4": true,
    "@cocreate/element-prototype@1.31.4": true,
    "@cocreate/observer@1.19.0": true,
    "@cocreate/utils@1.42.2": true,
    "@cocreate/webpack@1.4.3": true
  }
}
